$TTL 86400
@       IN  SOA root-ns.cs6008.local. admin.cs6008.local. (
                2026102001 ; serial
                3600       ; refresh
                900        ; retry
                604800     ; expire
                86400 )    ; minimum
        IN  NS  root-ns.cs6008.local.
root-ns.cs6008.local.  IN A 172.16.3.10

; Delegation to the com TLD, with glue so the resolver doesn't need
; to resolve tld-ns's name recursively (it couldn't yet, anyway).
; NOTE: the NS target must be in-bailiwick (a subdomain of the zone
; being delegated) or dnssec-signzone will strip the glue as
; out-of-zone data when the zone is signed.
com.                    IN  NS  tld-ns.com.
tld-ns.com.             IN  A   172.16.3.20
